/* Modern Dark Theme for FreeKhana SIEM GUI */

:root {
  /* Colors */
  --bg-primary: #0f0f23;
  --bg-secondary: #1a1a2e;
  --bg-tertiary: #16213e;
  --bg-hover: #0f3460;
  --bg-active: #1a1a2e;

  --text-primary: #ffffff;
  --text-secondary: #b8c5d6;
  --text-muted: #64748b;
  --text-accent: #00d4ff;

  --border-color: #2a2a4e;
  --border-hover: #3a3a6e;

  --accent-blue: #00d4ff;
  --accent-purple: #9c27b0;
  --accent-green: #4caf50;
  --accent-yellow: #ff9800;
  --accent-red: #f44336;
  --accent-cyan: #00bcd4;

  --shadow-light: rgba(0, 212, 255, 0.1);
  --shadow-medium: rgba(0, 212, 255, 0.15);
  --shadow-strong: rgba(0, 212, 255, 0.2);

  --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --gradient-secondary: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  --gradient-accent: linear-gradient(135deg, #00d4ff 0%, #090979 100%);

  /* Spacing */
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-2xl: 48px;

  /* Border radius */
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;

  /* Typography */
  --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  --font-mono: 'Consolas', 'Monaco', 'Courier New', monospace;

  /* Transitions */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
  --transition-slow: 0.4s ease;
}

/* Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: var(--font-family);
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
}

/* Scrollbar Styling */
QScrollBar:vertical {
  background: var(--bg-tertiary);
  width: 12px;
  border-radius: var(--radius-md);
}

QScrollBar::handle:vertical {
  background: var(--accent-blue);
  border-radius: var(--radius-md);
  min-height: 30px;
}

QScrollBar::handle:vertical:hover {
  background: var(--accent-cyan);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: none;
}

/* Main Window */
QMainWindow {
  background: var(--bg-primary);
  border: none;
}

QWidget#centralWidget {
  background: var(--bg-primary);
}

/* Header */
QFrame#header {
  background: var(--gradient-primary);
  border-bottom: 1px solid var(--border-color);
  padding: var(--spacing-lg);
  min-height: 80px;
}

QLabel#logo {
  font-size: 24px;
  font-weight: bold;
  color: var(--text-primary);
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
}

QLabel#logo svg, QLabel#logo QIcon {
  color: var(--accent-blue);
  filter: drop-shadow(0 0 8px rgba(0, 212, 255, 0.5));
}

/* Cards */
QGroupBox, QFrame.card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: 0 4px 20px var(--shadow-medium);
  transition: all var(--transition-normal);
}

QGroupBox:hover, QFrame.card:hover {
  border-color: var(--border-hover);
  box-shadow: 0 8px 30px var(--shadow-strong);
  transform: translateY(-2px);
}

QGroupBox::title {
  color: var(--accent-blue);
  font-size: 16px;
  font-weight: 600;
  padding: 0 var(--spacing-md);
  left: var(--spacing-md);
  top: -12px;
  background: var(--bg-secondary);
  border-radius: var(--radius-md);
}

/* Buttons */
QPushButton {
  background: var(--gradient-primary);
  color: var(--text-primary);
  border: none;
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 15px var(--shadow-light);
  transition: all var(--transition-fast);
  min-height: 44px;
}

QPushButton:hover {
  background: var(--gradient-secondary);
  box-shadow: 0 6px 25px var(--shadow-medium);
  transform: translateY(-2px);
}

QPushButton:pressed {
  background: var(--gradient-accent);
  box-shadow: 0 2px 10px var(--shadow-light);
  transform: translateY(0);
}

QPushButton.btn-secondary {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  box-shadow: none;
}

QPushButton.btn-secondary:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
}

QPushButton.btn-primary {
  background: var(--gradient-accent);
  color: var(--text-primary);
  font-size: 16px;
  padding: var(--spacing-lg) var(--spacing-2xl);
}

/* Tabs */
QTabWidget::pane {
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  background: var(--bg-secondary);
  top: -1px;
}

QTabBar::tab {
  background: var(--bg-tertiary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
  border-bottom: none;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  padding: var(--spacing-md) var(--spacing-lg);
  margin-right: 2px;
  font-size: 14px;
  font-weight: 500;
  transition: all var(--transition-fast);
  min-width: 120px;
}

QTabBar::tab:hover {
  background: var(--bg-hover);
  color: var(--text-primary);
  border-color: var(--border-hover);
}

QTabBar::tab:selected {
  background: var(--bg-secondary);
  color: var(--accent-blue);
  border-color: var(--accent-blue);
  border-bottom: 1px solid var(--bg-secondary);
  font-weight: 600;
}

QTabBar::tab:selected:hover {
  color: var(--accent-cyan);
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit {
  background: var(--bg-tertiary);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  color: var(--text-primary);
  font-family: var(--font-mono);
  font-size: 13px;
  transition: all var(--transition-fast);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
  border-color: var(--accent-blue);
  box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
  outline: none;
}

QLineEdit::placeholder, QTextEdit::placeholder, QPlainTextEdit::placeholder {
  color: var(--text-muted);
}

/* Combo Boxes */
QComboBox {
  background: var(--bg-tertiary);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  color: var(--text-primary);
  min-width: 120px;
  transition: all var(--transition-fast);
}

QComboBox:hover {
  border-color: var(--border-hover);
}

QComboBox:focus {
  border-color: var(--accent-blue);
  box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
}

QComboBox::drop-down {
  border: none;
  background: transparent;
}

QComboBox::down-arrow {
  image: url(down-arrow.svg);
  color: var(--text-secondary);
}

QComboBox QAbstractItemView {
  background: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  color: var(--text-primary);
  selection-background-color: var(--accent-blue);
}

/* Tables */
QTableWidget {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  gridline-color: var(--border-color);
  alternate-background-color: var(--bg-tertiary);
  selection-background-color: rgba(0, 212, 255, 0.1);
  selection-color: var(--text-primary);
}

QTableWidget::item {
  padding: var(--spacing-md);
  border-bottom: 1px solid var(--border-color);
  color: var(--text-primary);
}

QTableWidget::item:selected {
  background: rgba(0, 212, 255, 0.2);
  color: var(--text-primary);
}

QHeaderView::section {
  background: var(--gradient-primary);
  color: var(--text-primary);
  padding: var(--spacing-md);
  border: none;
  border-right: 1px solid var(--border-color);
  font-weight: 600;
  text-transform: uppercase;
  font-size: 12px;
  letter-spacing: 0.5px;
}

/* Progress Bar */
QProgressBar {
  background: var(--bg-tertiary);
  border: 2px solid var(--border-color);
  border-radius: var(--radius-xl);
  text-align: center;
  color: var(--text-primary);
  font-weight: 600;
}

QProgressBar::chunk {
  background: var(--gradient-accent);
  border-radius: var(--radius-lg);
}

/* List Widgets */
QListWidget {
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  alternate-background-color: var(--bg-tertiary);
  selection-background-color: var(--accent-blue);
  selection-color: var(--text-primary);
}

QListWidget::item {
  padding: var(--spacing-md);
  border-bottom: 1px solid var(--border-color);
  color: var(--text-primary);
}

QListWidget::item:selected {
  background: var(--accent-blue);
  color: var(--text-primary);
}

QListWidget::item:hover {
  background: var(--bg-hover);
}

/* Labels */
QLabel {
  color: var(--text-primary);
}

QLabel.title {
  font-size: 24px;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

QLabel.subtitle {
  font-size: 16px;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}

QLabel.mono {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--accent-cyan);
}

/* Status Bar */
QStatusBar {
  background: var(--bg-tertiary);
  border-top: 1px solid var(--border-color);
  color: var(--text-secondary);
  padding: var(--spacing-sm) var(--spacing-md);
}

/* Special Components */
QFrame.drop-zone {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.1) 0%, rgba(156, 39, 176, 0.1) 100%);
  border: 2px dashed var(--accent-blue);
  border-radius: var(--radius-xl);
  padding: var(--spacing-2xl);
  text-align: center;
  transition: all var(--transition-normal);
}

QFrame.drop-zone:hover {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(156, 39, 176, 0.2) 100%);
  border-color: var(--accent-cyan);
  box-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
}

QFrame.stats-card {
  background: var(--gradient-primary);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  text-align: center;
  box-shadow: 0 8px 32px var(--shadow-strong);
  transition: all var(--transition-normal);
}

QFrame.stats-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 48px var(--shadow-strong);
}

QFrame.stats-card QLabel.value {
  font-size: 32px;
  font-weight: bold;
  color: var(--text-primary);
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  display: block;
  margin-bottom: var(--spacing-sm);
}

QFrame.stats-card QLabel.label {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 500;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.5s ease-out;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.7; }
}

.pulse {
  animation: pulse 2s infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.spin {
  animation: spin 1s linear infinite;
}

/* Responsive Design */
@media (max-width: 1200px) {
  QTabBar::tab {
    min-width: 100px;
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 12px;
  }

  QPushButton {
    padding: var(--spacing-sm) var(--spacing-lg);
    font-size: 12px;
  }
}

@media (max-width: 768px) {
  QTabBar::tab {
    min-width: 80px;
    padding: var(--spacing-xs) var(--spacing-sm);
    font-size: 11px;
  }

  QPushButton {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 12px;
    min-height: 36px;
  }

  QGroupBox, QFrame.card {
    padding: var(--spacing-md);
  }
}